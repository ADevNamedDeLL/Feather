<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="feather-mocha" name="Feather Catppuccin Mocha" version="1.0">
  <author>Feather</author>
  <description>Low-glare Catppuccin Mocha syntax colors for Feather.</description>
  <color name="base" value="#1e1e2e"/>
  <color name="mantle" value="#181825"/>
  <color name="surface" value="#313244"/>
  <color name="selection" value="#41435a"/>
  <color name="text" value="#c6c8e6"/>
  <color name="subtext" value="#a6adc8"/>
  <color name="overlay" value="#6c7086"/>
  <color name="mauve" value="#cba6f7"/>
  <color name="blue" value="#89b4fa"/>
  <color name="green" value="#a6e3a1"/>
  <color name="yellow" value="#f9e2af"/>
  <color name="peach" value="#fab387"/>
  <color name="red" value="#f38ba8"/>
  <color name="teal" value="#94e2d5"/>
  <color name="pink" value="#f5c2e7"/>

  <style name="text" foreground="text" background="base"/>
  <style name="selection" foreground="#b4befe" background="selection"/>
  <style name="cursor" foreground="mauve"/>
  <style name="line-numbers" foreground="overlay" background="mantle"/>
  <style name="current-line" background="#232336"/>
  <style name="right-margin" foreground="#45475a"/>
  <style name="bracket-match" foreground="yellow" background="#45475a" bold="true"/>
  <style name="draw-spaces" foreground="#585b70"/>

  <style name="def:comment" foreground="overlay" italic="true"/>
  <style name="def:doc-comment" foreground="#7f849c" italic="true"/>
  <style name="def:keyword" foreground="mauve" bold="true"/>
  <style name="def:statement" foreground="mauve"/>
  <style name="def:string" foreground="green"/>
  <style name="def:character" foreground="green"/>
  <style name="def:decimal" foreground="peach"/>
  <style name="def:base-n-integer" foreground="peach"/>
  <style name="def:floating-point" foreground="peach"/>
  <style name="def:constant" foreground="peach"/>
  <style name="def:boolean" foreground="peach"/>
  <style name="def:type" foreground="yellow"/>
  <style name="def:storage-class" foreground="mauve"/>
  <style name="def:function" foreground="blue"/>
  <style name="def:identifier" foreground="text"/>
  <style name="def:operator" foreground="teal"/>
  <style name="def:preprocessor" foreground="red"/>
  <style name="def:special-char" foreground="pink"/>
  <style name="def:special-constant" foreground="peach"/>
  <style name="def:underlined" foreground="blue" underline="single"/>
  <style name="def:error" foreground="red" underline="error"/>
  <style name="def:warning" foreground="peach" underline="single"/>
</style-scheme>
